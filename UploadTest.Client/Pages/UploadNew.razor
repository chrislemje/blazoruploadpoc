@page "/uploadnew"
@rendermode InteractiveWebAssembly
@inject HttpClient Http

<h3>New WebAssembly Upload (Fixed Version)</h3>

<p class="alert alert-success">
    <strong>Render Mode:</strong> InteractiveWebAssembly<br />
    <strong>Fix:</strong> This component executes inside the client-side WebAssembly runtime. 
    When Android suspends the browser tab to display the native file picker, no Blazor Server SignalR circuit is dropped. 
    Upon returning focus, WebAssembly resumes seamlessly and posts the file payload via standard HTTP API.
</p>

<div class="mb-3">
    <label for="wasmFileInput" class="form-label">Select a file (Works reliably on Android):</label>
    <InputFile id="wasmFileInput" OnChange="HandleFileSelected" class="form-control" />
</div>

@if (isLoading)
{
    <div class="spinner-border text-success" role="status">
        <span class="visually-hidden">Uploading...</span>
    </div>
    <p>Uploading file via WebAssembly client stream...</p>
}

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert-info mt-3">
        @statusMessage
    </div>
}

@if (selectedFile != null)
{
    <div class="card mt-3">
        <div class="card-body">
            <h5 class="card-title">File Details</h5>
            <p class="card-text"><strong>Name:</strong> @selectedFile.Name</p>
            <p class="card-text"><strong>Size:</strong> @selectedFile.Size bytes</p>
            <p class="card-text"><strong>Type:</strong> @selectedFile.ContentType</p>
            <p class="card-text"><strong>Last Modified:</strong> @selectedFile.LastModified.ToString("G")</p>
        </div>
    </div>
}

@code {
    private IBrowserFile? selectedFile;
    private bool isLoading = false;
    private string statusMessage = string.Empty;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        isLoading = true;
        statusMessage = "File selected, processing locally in WebAssembly...";

        try
        {
            selectedFile = e.File;

            // Process locally or stream directly to a REST API endpoint via HttpClient
            using var content = new MultipartFormDataContent();
            using var fileStream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var streamContent = new StreamContent(fileStream);
            
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(selectedFile.ContentType);
            content.Add(streamContent, "file", selectedFile.Name);

            // In a real app, you would post to your server controller:
            // var response = await Http.PostAsync("api/upload", content);

            // Simulating successful processing client-side
            await Task.Delay(500); 

            statusMessage = $"Successfully processed '{selectedFile.Name}' ({selectedFile.Size} bytes) inside WebAssembly without circuit drop!";
        }
        catch (Exception ex)
        {
            statusMessage = $"Error processing upload: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
